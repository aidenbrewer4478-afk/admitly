<!DOCTYPE html>
<html>
<head>
<base target="_top">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600;700&family=Patrick+Hand&display=swap');

  :root{
    --ink:#2E2A24; --bg:#FAF6EF; --panel:#F1EAD9; --paper:#FFFFFF;
    --paper-dim:#6F6A5D; --coral:#E8735A; --coral-dim:#C15A44;
    --sage:#7A9B76; --highlight:#F5D98C; --muted:#948C7C;
  }
  *{box-sizing:border-box;}
  body{margin:0; font-family:'Inter', sans-serif; background:var(--bg); color:var(--ink); padding:18px;}
  .logo{font-family:'Fraunces', serif; font-weight:700; font-size:20px; margin-bottom:4px;}
  .logo span{color:var(--coral);}
  .tagline{font-size:12px; color:var(--muted); margin-bottom:14px;}

  .plan-badge{
    display:inline-block; font-size:11.5px; font-weight:600;
    padding:4px 10px; border-radius:20px; margin-bottom:16px;
  }
  .plan-free{background:var(--panel); color:var(--paper-dim);}
  .plan-paid{background:rgba(122,155,118,0.18); color:#5C7A58;}

  select, button{
    width:100%; font-family:'Inter', sans-serif; font-size:14px;
    padding:10px 12px; border-radius:3px; border:1px solid rgba(46,42,36,0.15);
    background:var(--paper); color:var(--ink); margin-bottom:10px;
  }
  button{background:var(--coral); color:#fff; font-weight:600; border:none; cursor:pointer; margin-top:4px;}
  button:disabled{opacity:0.5; cursor:default;}
  .btn-upgrade{background:var(--sage);}

  .meta{font-size:12px; color:var(--muted); margin-bottom:14px;}
  #status{font-size:13px; color:var(--muted); padding:10px 0; display:none;}

  .card{
    background:var(--paper); border:1px solid rgba(46,42,36,0.1);
    border-radius:6px; padding:14px; margin-bottom:12px;
    box-shadow:0 2px 8px rgba(46,42,36,0.04);
  }
  .card h3{font-family:'Fraunces', serif; font-size:14px; margin:0 0 8px 0;}
  .card p{font-size:13.5px; color:var(--paper-dim); margin:0;}

  .strength{
    display:inline-block; background:rgba(122,155,118,0.15); color:#5C7A58;
    font-size:12px; padding:3px 8px; border-radius:2px; margin:2px 4px 2px 0;
  }

  .flag-quote{
    font-family:'Fraunces', serif; font-size:13.5px; font-style:italic;
    border-left:2px solid var(--coral-dim); padding-left:8px; margin-bottom:6px;
  }
  .flag-issue{font-size:12.5px; color:var(--muted); margin-bottom:8px;}
  .flag-rewrite{font-family:'Patrick Hand', cursive; font-size:16.5px; color:var(--coral-dim);}

  .next-step{
    background:var(--panel); border:1px dashed var(--coral-dim);
    border-radius:6px; padding:12px; font-size:13px;
  }

  .paywall{
    background:var(--panel); border-radius:6px; padding:18px; text-align:center;
  }
  .paywall h3{font-family:'Fraunces', serif; font-size:16px; margin-bottom:8px;}
  .paywall p{font-size:13px; color:var(--paper-dim); margin-bottom:14px;}

  #result{display:none;}
</style>
</head>
<body>

<div class="logo">Admit<span>ly</span></div>
<div class="tagline">Admissions-reader feedback, right in your doc.</div>
<div id="planBadge" class="plan-badge plan-free">Loading plan…</div>

<label style="font-size:12px; color:var(--muted);">Essay type</label>
<select id="essayType">
  <option value="Common App personal statement">Common App personal statement</option>
  <option value="Supplemental essay">Supplemental essay</option>
  <option value="Scholarship essay">Scholarship essay</option>
</select>

<button id="reviewBtn" onclick="runReview()">Review this essay</button>
<div class="meta" id="wordCount"></div>
<div id="status"></div>

<div id="paywallBox" class="paywall" style="display:none;">
  <h3>Free reviews used up for this month</h3>
  <p>You've used both free essay reviews this month. Upgrade for unlimited reviews and rounds.</p>
  <button class="btn-upgrade" onclick="goUpgrade()">Upgrade — $12/mo</button>
</div>

<div id="result">
  <div class="card"><h3>Overall</h3><p id="overallText"></p></div>
  <div class="card"><h3>What's working</h3><div id="strengthsList"></div></div>
  <div id="flagsList"></div>
  <div class="next-step" id="nextStepBox"></div>
</div>

<div style="text-align:center; margin-top:16px; font-size:11px; color:var(--muted);">
  <a href="https://admitly-woad.vercel.app/privacy" style="color:var(--muted);">Privacy</a> ·
  <a href="https://admitly-woad.vercel.app/terms" style="color:var(--muted);">Terms</a>
</div>

<script>
  let checkoutUrl = null;

  window.onload = function () {
    google.script.run.withSuccessHandler(function (access) {
      const badge = document.getElementById('planBadge');
      if (access.isPaid) {
        badge.textContent = 'Unlimited plan';
        badge.className = 'plan-badge plan-paid';
      } else {
        badge.textContent = access.remaining + ' of 2 free reviews left this month';
        badge.className = 'plan-badge plan-free';
      }
    }).getAccessStatus();
  };

  function runReview() {
    const btn = document.getElementById('reviewBtn');
    const status = document.getElementById('status');
    const result = document.getElementById('result');
    const paywallBox = document.getElementById('paywallBox');
    const essayType = document.getElementById('essayType').value;

    btn.disabled = true;
    status.style.display = 'block';
    status.textContent = 'Reading your doc…';
    result.style.display = 'none';
    paywallBox.style.display = 'none';

    google.script.run
      .withSuccessHandler(function (essay) {
        document.getElementById('wordCount').textContent = essay.title + ' · ' + essay.wordCount + ' words';

        if (essay.wordCount < 30) {
          status.textContent = 'Write a bit more before requesting feedback.';
          btn.disabled = false;
          return;
        }

        status.textContent = 'Reading like an admissions officer…';

        google.script.run
          .withSuccessHandler(function (feedback) {
            renderFeedback(feedback);
            status.style.display = 'none';
            btn.disabled = false;
          })
          .withFailureHandler(function (err) {
            if (err.message && err.message.indexOf('PAYWALL') === 0) {
              status.style.display = 'none';
              paywallBox.style.display = 'block';
            } else {
              status.textContent = 'Error: ' + err.message;
            }
            btn.disabled = false;
          })
          .getFeedback(essay.text, essayType);
      })
      .withFailureHandler(function (err) {
        status.textContent = 'Error: ' + err.message;
        btn.disabled = false;
      })
      .getEssayText();
  }

  function goUpgrade() {
    google.script.run.withSuccessHandler(function (url) {
      window.open(url, '_blank');
    }).getCheckoutUrlForCurrentUser();
  }

  function renderFeedback(fb) {
    document.getElementById('overallText').textContent = fb.overall;
    const strengthsList = document.getElementById('strengthsList');
    strengthsList.innerHTML = '';
    (fb.strengths || []).forEach(function (s) {
      const span = document.createElement('span');
      span.className = 'strength';
      span.textContent = s;
      strengthsList.appendChild(span);
    });

    const flagsList = document.getElementById('flagsList');
    flagsList.innerHTML = '';
    (fb.flags || []).forEach(function (f) {
      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML =
        '<div class="flag-quote">"' + escapeHtml(f.quote) + '"</div>' +
        '<div class="flag-issue">' + escapeHtml(f.issue) + '</div>' +
        '<div class="flag-rewrite">↳ ' + escapeHtml(f.rewrite) + '</div>';
      flagsList.appendChild(card);
    });

    document.getElementById('nextStepBox').textContent = fb.nextStep;
    document.getElementById('result').style.display = 'block';
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
</script>

</body>
</html>
