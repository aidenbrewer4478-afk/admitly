<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600;700&family=Patrick+Hand&display=swap');

  :root{
    --ink:#2E2A24; --bg:#FAF6EF; --panel:#F1EAD9; --paper:#FFFFFF;
    --paper-dim:#6F6A5D; --coral:#E8735A; --coral-dim:#C15A44;
    --sage:#7A9B76; --muted:#948C7C;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; width:340px; max-height:560px; overflow-y:auto;
    font-family:'Inter', sans-serif; background:var(--bg); color:var(--ink); padding:16px;
  }
  .logo{font-family:'Fraunces', serif; font-weight:700; font-size:19px; margin-bottom:2px;}
  .logo span{color:var(--coral);}
  .tagline{font-size:11.5px; color:var(--muted); margin-bottom:12px;}

  .plan-badge{
    display:inline-block; font-size:11px; font-weight:600;
    padding:3px 9px; border-radius:20px; margin-bottom:12px;
  }
  .plan-free{background:var(--panel); color:var(--paper-dim);}
  .plan-paid{background:rgba(122,155,118,0.18); color:#5C7A58;}

  textarea, select, button{
    width:100%; font-family:'Inter', sans-serif; font-size:13.5px;
    padding:9px 10px; border-radius:3px; border:1px solid rgba(46,42,36,0.15);
    background:var(--paper); color:var(--ink); margin-bottom:8px;
  }
  textarea{height:90px; resize:vertical;}
  button{background:var(--coral); color:#fff; font-weight:600; border:none; cursor:pointer;}
  button.secondary{background:var(--paper); color:var(--ink); border:1px solid rgba(46,42,36,0.15);}
  button.upgrade{background:var(--sage);}
  button:disabled{opacity:0.5; cursor:default;}

  #signedOut{text-align:center; padding:20px 0;}
  #signedOut p{font-size:13px; color:var(--paper-dim); margin-bottom:14px;}

  #status{font-size:12.5px; color:var(--muted); padding:6px 0; display:none;}

  .card{
    background:var(--paper); border:1px solid rgba(46,42,36,0.1);
    border-radius:6px; padding:11px; margin-bottom:9px;
  }
  .card h3{font-family:'Fraunces', serif; font-size:13px; margin:0 0 6px 0;}
  .card p{font-size:12.5px; color:var(--paper-dim); margin:0;}

  .strength{
    display:inline-block; background:rgba(122,155,118,0.15); color:#5C7A58;
    font-size:11px; padding:2px 7px; border-radius:2px; margin:2px 3px 2px 0;
  }

  .flag-quote{
    font-family:'Fraunces', serif; font-size:12.5px; font-style:italic;
    border-left:2px solid var(--coral-dim); padding-left:7px; margin-bottom:5px;
  }
  .flag-issue{font-size:11.5px; color:var(--muted); margin-bottom:6px;}
  .flag-rewrite{font-family:'Patrick Hand', cursive; font-size:15px; color:var(--coral-dim);}

  .next-step{
    background:var(--panel); border:1px dashed var(--coral-dim);
    border-radius:6px; padding:10px; font-size:12px;
  }

  .paywall{background:var(--panel); border-radius:6px; padding:14px; text-align:center;}
  .paywall h3{font-family:'Fraunces', serif; font-size:14px; margin-bottom:6px;}
  .paywall p{font-size:12px; color:var(--paper-dim); margin-bottom:10px;}

  #result, #signedIn{display:none;}
</style>
</head>
<body>

<div class="logo">Admit<span>ly</span></div>
<div class="tagline">Select your essay anywhere, get feedback here.</div>

<div id="signedOut">
  <p>Sign in with Google to get started.</p>
  <button onclick="signIn()">Sign in with Google</button>
</div>

<div id="signedIn">
  <div id="planBadge" class="plan-badge plan-free">Loading plan…</div>

  <button class="secondary" onclick="grabSelection()">Use selected text on page</button>
  <textarea id="essayText" placeholder="Or paste your essay here…"></textarea>

  <select id="essayType">
    <option value="Common App personal statement">Common App personal statement</option>
    <option value="Supplemental essay">Supplemental essay</option>
    <option value="Scholarship essay">Scholarship essay</option>
  </select>

  <button id="reviewBtn" onclick="runReview()">Review this essay</button>
  <div id="status"></div>

  <div id="paywallBox" class="paywall" style="display:none;">
    <h3>Free reviews used up</h3>
    <p>You've used both free reviews this month.</p>
    <button class="upgrade" onclick="goUpgrade()">Upgrade — $12/mo</button>
  </div>

  <div id="result">
    <div class="card"><h3>Overall</h3><p id="overallText"></p></div>
    <div class="card"><h3>What's working</h3><div id="strengthsList"></div></div>
    <div id="flagsList"></div>
    <div class="next-step" id="nextStepBox"></div>
  </div>
</div>

<div style="text-align:center; margin-top:12px; font-size:10.5px; color:var(--muted);">
  <a href="https://admitly-woad.vercel.app/privacy" target="_blank" style="color:var(--muted);">Privacy</a> ·
  <a href="https://admitly-woad.vercel.app/terms" target="_blank" style="color:var(--muted);">Terms</a>
</div>

<script src="popup.js"></script>
</body>
</html>
